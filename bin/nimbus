#!/usr/bin/env bash
# Nimbus Master CLI Wrapper
set -e

APP_DIR="/usr/local/nimbus"

if [ ! -d "$APP_DIR" ]; then
    APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

BIN_NAME="$(basename "$0")"

# If invoked directly as a prefixed binary (e.g. nimbus:reset-admin-password)
if [ "$BIN_NAME" = "nimbus:reset-admin-password" ]; then
    exec php "$APP_DIR/artisan" nimbus:reset-admin-password "$@"
fi

if [ "$BIN_NAME" = "nimbus:2fa-disable" ]; then
    exec php "$APP_DIR/artisan" nimbus:2fa-disable "$@"
fi

if [ "$BIN_NAME" = "nimbus:unban" ]; then
    exec php "$APP_DIR/artisan" nimbus:unban "$@"
fi

# If invoked as 'nimbus <subcommand>'
case "$1" in
    reset-admin-password|nimbus:reset-admin-password)
        shift
        exec php "$APP_DIR/artisan" nimbus:reset-admin-password "$@"
        ;;
    2fa-disable|disable-2fa|nimbus:2fa-disable)
        shift
        exec php "$APP_DIR/artisan" nimbus:2fa-disable "$@"
        ;;
    unban|nimbus:unban)
        shift
        exec php "$APP_DIR/artisan" nimbus:unban "$@"
        ;;
    purge-trash|nimbus:purge-trash)
        shift
        exec php "$APP_DIR/artisan" nimbus:purge-trash "$@"
        ;;
    collect-metrics|nimbus:collect-metrics)
        shift
        exec php "$APP_DIR/artisan" nimbus:collect-metrics "$@"
        ;;
    *)
        exec php "$APP_DIR/artisan" "$@"
        ;;
esac
